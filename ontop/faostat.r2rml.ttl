    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant qb:ComponentSpecification ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:dimension ; rr:objectMap [ rr:constant sdmx-dimension:refArea ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:order ; rr:objectMap [ rr:constant 1 ] ] .



    rr:predicateObjectMap [ rr:predicate rdfs:range ; rr:objectMap [ rr:constant skos:Concept ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:codeList ; rr:objectMap [ rr:constant <https://example.org/faostat/scheme/area> ] ] .



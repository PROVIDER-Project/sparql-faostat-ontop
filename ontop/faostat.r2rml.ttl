<https://example.org/faostat/mapping/structure> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/faostat/structure/QCL> ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant qb:DataStructureDefinition ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/area> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/item> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/element> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/period> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/value> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/unit> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/flag> ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:component ; rr:objectMap [ rr:constant <https://example.org/faostat/component/note> ] ] .


<https://example.org/faostat/mapping/area-component> a rr:TriplesMap ;

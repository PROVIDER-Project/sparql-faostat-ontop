# R2RML mapping for the FAOSTAT QCL 2025 snapshot in DuckDB.
# Code lists are deduplicated during loading; observation keys are in the lens.
# Column literals have explicit RDF datatypes; metadata is mapped from SELECT 1.
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix ex: <https://example.org/faostat/vocab/> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix sdmx-dimension: <http://purl.org/linked-data/sdmx/2009/dimension#> .
@prefix sdmx-attribute: <http://purl.org/linked-data/sdmx/2009/attribute#> .
@prefix sdmx-measure: <http://purl.org/linked-data/sdmx/2009/measure#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<https://example.org/faostat/mapping/observations> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "faostat_observations" ] ;
    rr:subjectMap [ rr:template "https://example.org/faostat/observation/QCL/{OBSERVATION_LOCAL_NAME}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant qb:Observation ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:dataSet ; rr:objectMap [ rr:constant <https://example.org/faostat/dataset/QCL> ] ] ;
    rr:predicateObjectMap [ rr:predicate sdmx-dimension:refArea ; rr:objectMap [ rr:template "https://example.org/faostat/area/{AREA_CODE_LEXICAL}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:item ; rr:objectMap [ rr:template "https://example.org/faostat/item/{ITEM_CODE_LEXICAL}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:element ; rr:objectMap [ rr:template "https://example.org/faostat/element/{ELEMENT_CODE_LEXICAL}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate sdmx-dimension:refPeriod ; rr:objectMap [ rr:column "YEAR_LEXICAL" ; rr:termType rr:Literal ; rr:datatype xsd:gYear ] ] ;
    rr:predicateObjectMap [ rr:predicate sdmx-measure:obsValue ; rr:objectMap [ rr:column "OBS_VALUE_LEXICAL" ; rr:termType rr:Literal ; rr:datatype xsd:double ] ] ;
    rr:predicateObjectMap [ rr:predicate sdmx-attribute:unitMeasure ; rr:objectMap [ rr:template "https://example.org/faostat/unit/{UNIT}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:flag ; rr:objectMap [ rr:template "https://example.org/faostat/flag/{FLAG}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:note ; rr:objectMap [ rr:column "NOTE" ; rr:termType rr:Literal ; rr:datatype xsd:string ] ] .


<https://example.org/faostat/mapping/dataset> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/faostat/dataset/QCL> ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant qb:DataSet ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:identifier ; rr:objectMap [ rr:constant "QCL-2025" ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:title ; rr:objectMap [ rr:constant "FAOSTAT - Production: Crops and livestock products (2025 snapshot)" ] ] ;
    rr:predicateObjectMap [ rr:predicate qb:structure ; rr:objectMap [ rr:constant <https://example.org/faostat/structure/QCL> ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:publisher ; rr:objectMap [ rr:constant <https://www.fao.org/> ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:source ; rr:objectMap [ rr:constant <https://www.fao.org/faostat/en/#data/QCL> ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:license ; rr:objectMap [ rr:constant <https://creativecommons.org/licenses/by/4.0/> ] ] ;
    rr:predicateObjectMap [ rr:predicate dct:bibliographicCitation ; rr:objectMap [ rr:constant "FAO. 2025. FAOSTAT: Production: Crops and livestock products. [Accessed on 10 October 2026]. https://www.fao.org/faostat/en/#data/QCL. Licence: CC-BY-4.0." ] ] .


<https://example.org/faostat/mapping/area-codes> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "faostat_area" ] ;
    rr:subjectMap [ rr:template "https://example.org/faostat/area/{AREA_CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant skos:Concept ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:objectMap [ rr:constant <https://example.org/faostat/scheme/area> ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "AREA_CODE" ; rr:termType rr:Literal ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "AREA" ; rr:termType rr:Literal ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:m49Code ; rr:objectMap [ rr:column "M49_CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ] ] .


<https://example.org/faostat/mapping/area-scheme> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/faostat/scheme/area> ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant skos:ConceptScheme ] ] ;
    rr:predicateObjectMap [ rr:predicate rdfs:label ; rr:objectMap [ rr:constant "FAOSTAT area codes" ] ] .


<https://example.org/faostat/mapping/item-codes> a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "faostat_item" ] ;
    rr:subjectMap [ rr:template "https://example.org/faostat/item/{ITEM_CODE}" ; rr:termType rr:IRI ] ;
    rr:predicateObjectMap [ rr:predicate rdf:type ; rr:objectMap [ rr:constant skos:Concept ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:inScheme ; rr:objectMap [ rr:constant <https://example.org/faostat/scheme/item> ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:notation ; rr:objectMap [ rr:column "ITEM_CODE" ; rr:termType rr:Literal ; rr:datatype xsd:integer ] ] ;
    rr:predicateObjectMap [ rr:predicate skos:prefLabel ; rr:objectMap [ rr:column "ITEM" ; rr:termType rr:Literal ; rr:datatype xsd:string ] ] ;
    rr:predicateObjectMap [ rr:predicate ex:cpcCode ; rr:objectMap [ rr:column "CPC_CODE" ; rr:termType rr:Literal ; rr:datatype xsd:string ] ] .


<https://example.org/faostat/mapping/item-scheme> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT 1 AS singleton" ] ;
    rr:subjectMap [ rr:constant <https://example.org/faostat/scheme/item> ] ;

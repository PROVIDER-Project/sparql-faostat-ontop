# Optional build configuration for Make. Copy to .env and use absolute paths.
# This file uses Make assignment syntax; do not quote values.
# M2_DIR defaults to endpoint/.cache/maven. Environment and CLI overrides work.
# M2_DIR=/mnt/datasets/faostat-m2

# Optional individual settings-file overrides; otherwise taken from $HOME/.m2.
# M2_SETTINGS=/home/me/.m2/settings.xml
# M2_SECURITY=/home/me/.m2/settings-security.xml

# Endpoint and database releases are independent.
# VERSION=0.0.2
# DATABASE_VERSION=0.0.1

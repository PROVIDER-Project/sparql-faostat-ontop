<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.aksw.data.config</groupId>
    <artifactId>aksw-data-deployment</artifactId>
    <version>0.0.8</version>
  </parent>
  <groupId>org.aksw.data.faostat</groupId>
  <artifactId>faostat-qcl-2025-duckdb</artifactId>
  <version>0.0.1</version>
  <packaging>pom</packaging>

  <name>PROVIDER - FAOSTAT QCL 2025 preloaded DuckDB</name>
  <description>
    A Zstandard-compressed, preloaded DuckDB database derived from the FAOSTAT
    Production: Crops and livestock products (QCL) 2025 snapshot, with FAOSTAT
    Country/Region and Country Group definitions retrieved on 15 October 2026.

    Produced by the PROVIDER FAOSTAT-to-SPARQL project:
    https://github.com/PROVIDER-Project/sparql-faostat-ontop
    The database supports that project's Ontop R2RML mappings and virtual
    QB/SDMX graph; RDF is not materialized in this artifact.

    Transformations include typed CSV ingestion, normalization of spreadsheet
    quoting in M49/CPC codes while retaining leading zeros, derived observation
    lookup keys, deduplicated code lists, lookup indexes, and geographic
    area-to-country links with audit tables. Country-link eligibility and
    exclusions follow the policy documented in the project repository.
    The generated database is compressed losslessly as a duckdb.zst artifact.

    Source: https://www.fao.org/faostat/en/#data/QCL
    Geographic definitions: https://www.fao.org/faostat/en/#definitions

    Attribution: FAO. 2025. FAOSTAT: Production: Crops and livestock products.
    [Accessed on 10 October 2026]. https://www.fao.org/faostat/en/#data/QCL.
    Licence: CC-BY-4.0.
    FAO. FAOSTAT: Definitions and Standards, Country/Region and Country Group.
    [Accessed on 15 October 2026]. https://www.fao.org/faostat/en/#definitions.
    Licence: CC-BY-4.0.

    This is a transformed data product of the PROVIDER project. FAO does not
    sponsor, approve or endorse this artifact or its derived country links.
  </description>
  <url>https://github.com/PROVIDER-Project/sparql-faostat-ontop</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>PROVIDER Project</name>
    <url>https://github.com/PROVIDER-Project</url>
  </organization>
  <developers>
